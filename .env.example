MEMORY_HOST=127.0.0.1
MEMORY_PORT=8000
MEMORY_DATA_DIR=./data
MEMORY_DB_PATH=./data/memory.db
MEMORY_LIBRARY_DIR=./data/library
MEMORY_MAX_UPLOAD_MB=100
MEMORY_AI_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
MEMORY_EMBEDDING_BACKEND=auto
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# OCR backend for imported images: auto (macOS Vision if installed), macos-vision, or none
MEMORY_OCR_BACKEND=auto
# Optional read-only Notion sync. Create an internal integration, share the
# pages with it, and paste its secret here. Leave blank to disable Notion.
NOTION_TOKEN=
